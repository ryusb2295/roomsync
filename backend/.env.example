# SQLite database file. Relative paths are resolved from the server process directory.
ROOMSYNC_DB_PATH=backend/data/roomsync.db

# Comma-separated frontend origins. Use the exact frontend URL outside local development.
ROOMSYNC_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Receipt provider: gemini, openai, or mock
ROOMSYNC_RECEIPT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-api-key
ROOMSYNC_GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI is only needed when ROOMSYNC_RECEIPT_PROVIDER=openai.
# OPENAI_API_KEY=replace-with-your-api-key
# ROOMSYNC_RECEIPT_MODEL=gpt-4.1-mini

# Mock must be enabled explicitly when the provider is mock.
ROOMSYNC_RECEIPT_MOCK_ENABLED=false

# Development only. Raw receipt responses can contain personal purchase information.
ROOMSYNC_RECEIPT_DEBUG=false
